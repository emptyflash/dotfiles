{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "superpowers@git+https://github.com/obra/superpowers.git"
  ],
  "agent": {
    "explore": {
      "model": "deepseek/deepseek-flash",
      "mode": "subagent"
    },
    "general": {
      "model": "deepseek/deepseek-flash",
      "mode": "subagent"
    },
    "vision": {
      "model": "opencode/qwen3.6-plus",
      "mode": "subagent",
      "description": "Use when you need to understand, describe, or answer questions about images. This agent has strong vision capabilities and can analyze screenshots, diagrams, photos, and other visual content."
    }
  },
  "keybinds": {
    "input_submit": "alt+enter"
  },
  "mcp": {
    "chrome-devtools": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@latest"
      ]
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "@playwright/mcp@latest"
      ]
    },
    "expo": {
      "type": "remote",
      "url": "https://mcp.expo.dev/mcp",
      "oauth": {}
    },
    "mobile-next": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@mobilenext/mobile-mcp@latest"
      ]
    },
    "sanctu-figma": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "figma-developer-mcp",
        "--figma-api-key={env:SANCTU_FIGMA_API_KEY}",
        "--stdio"
      ]
    },
    "cam-figma": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "figma-developer-mcp",
        "--figma-api-key={env:CAM_FIGMA_API_KEY}",
        "--stdio"
      ]
    },
    "sanctu-github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:GITHUB_SANCTU_ACCESS_TOKEN}"
      }
    },
    "cam-github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    },
    "summerdiscovery-github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:GITHUB_SUMMERDISCOVERY_ACCESS_TOKEN}"
      }
    },
    "sanctu notion": {
      "type": "remote",
      "url": "https://mcp.notion.com/mcp",
      "oauth": {}
    },
    "Summer Discovery Sanity": {
      "headers": {
        "Authorization": "Bearer {env:SANCTU_FIGMA_API_KEY}"
      },
      "type": "remote",
      "url": "https://mcp.sanity.io"
    },
    "OxSC SFDC": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@salesforce/mcp",
        "--orgs",
        "DEFAULT_TARGET_ORG",
        "--toolsets",
        "orgs,metadata,data,users",
        "--allow-non-ga-tools"
      ]
    },
    "Summer Discovery Zenhub": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "mcp-remote",
        "https://api.zenhub.com/mcp",
        "--header",
        "Authorization:{env:ZENHUB_API_TOKEN}",
        "--header",
        "X-zh-workspace:6a4eaa8dffc700001cc4850f"
      ]
    },
    "Summer Discovery Courses": {
      "type": "remote",
      "url": "http://localhost:3000/mcp"
    },
    "aws-mcp": {
      "type": "local",
      "command": [
        "uvx",
        "mcp-proxy-for-aws@latest",
        "https://aws-mcp.us-east-1.api.aws/mcp",
        "--metadata",
        "INSTALL_SOURCE=aws-cli"
      ]
    }
  }
}
